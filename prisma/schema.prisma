generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Location {
  id                   String        @id @default(cuid())
  name                 String        @unique
  city                 String
  state                String
  pickupReservations   Reservation[] @relation("PickupLocation")
  returnReservations   Reservation[] @relation("ReturnLocation")
}

model Car {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  pricePerDay Float
  imageUrl    String
  images      String   @default("[]")
  features    String   @default("[]")
  seats       Int
  bags        Int
  transmission String
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reservations Reservation[]
}

model Protection {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  pricePerDay Float
  benefits    String
  reservations Reservation[]
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

model Reservation {
  id                 String            @id @default(cuid())
  code               String            @unique
  status             ReservationStatus @default(CONFIRMED)
  pickupDate         DateTime
  pickupTime         String
  returnDate         DateTime
  returnTime         String
  days               Int
  carSubtotal        Float
  protectionSubtotal Float             @default(0)
  totalPrice         Float
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  userId             String
  user               User              @relation(fields: [userId], references: [id])
  carId              String
  car                Car               @relation(fields: [carId], references: [id])
  pickupLocationId   String
  pickupLocation     Location          @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  returnLocationId   String
  returnLocation     Location          @relation("ReturnLocation", fields: [returnLocationId], references: [id])
  protectionId       String?
  protection         Protection?       @relation(fields: [protectionId], references: [id])
}
